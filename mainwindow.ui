    border-radius: 8px;
    color: #E0E0E6;
    padding: 5px;
}
QListWidget::item:selected {
    background-color: #6366F1;
    color: white;
    border-radius: 4px;
}
QPushButton {
    background-color: #24273A;
    color: #E0E0E6;
    border: 1px solid #3B3F5C;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #31354F;
    border-color: #6366F1;
}
QPushButton:pressed {
    background-color: #1A1C29;
}
QLabel {

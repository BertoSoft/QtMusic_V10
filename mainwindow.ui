    font-family: &quot;Noto Sans&quot;, &quot;Segoe UI&quot;, sans-serif;
}
QProgressBar {
    background-color: #24273A;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 #6366F1, stop:1 #A855F7);
    border-radius: 4px;
}
